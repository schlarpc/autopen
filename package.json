{
  "name": "autopen",
  "version": "0.1.0",
  "description": "Compact binary serialization for hand-drawn signatures with delta encoding and arithmetic compression",
  "keywords": [
    "signature",
    "canvas",
    "serialization",
    "encoding",
    "compression",
    "svg",
    "handwriting"
  ],
  "author": "schlarpc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlarpc/autopen.git"
  },
  "homepage": "https://schlarpc.github.io/autopen/",
  "bugs": {
    "url": "https://github.com/schlarpc/autopen/issues"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist demo-dist",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "prepublishOnly": "npm run clean && npm run build && npm run test:run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
